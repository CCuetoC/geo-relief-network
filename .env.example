# Geo Relief Network — example configuration only.
# Keep real credentials in .env.local or the deployment provider's secret store.
# Never prefix server secrets with NEXT_PUBLIC_.

# Neon Postgres (use the pooled URL for application requests; unpooled is for migrations).
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Neon Auth Managed Better Auth. Values are branch-specific and supplied by Neon.
NEON_AUTH_BASE_URL=
NEON_AUTH_JWKS_URL=
# App-side cookie signing secret, when the Next.js Auth integration is enabled.
NEON_AUTH_COOKIE_SECRET=

# Meta Model API — Muse Spark.
MODEL_API_KEY=

# Neon Object Storage (S3-compatible, private bucket).
# AWS_* are Neon's documented S3 credential/endpoint variables; bucket name is app configuration.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=
OBJECT_STORAGE_BUCKET=

# WhatsApp Cloud API integration. These names are application configuration keys.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# App-managed cryptographic secrets; generate independent high-entropy values for each.
WHATSAPP_LOOKUP_HMAC_KEY=
WHATSAPP_DESTINATION_ENCRYPTION_KEY=

# Browser-visible key. Restrict it to the application's HTTP referrers and required APIs
# in Google Cloud Console; it is not a server secret.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
